# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
# ---------------------------------------------------------------------------

# Public origin of the site. Used for OG tags and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ----------------------------------------------------------------
# Dashboard -> Developers -> API keys. Use sk_test_... until you're live.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, or from
# the webhook endpoint you create in the Stripe dashboard for production.
STRIPE_WEBHOOK_SECRET=

# --- Shippo ----------------------------------------------------------------
# goshippo.com -> Settings -> API. shippo_test_... works without spending money.
SHIPPO_API_KEY=

# Buying a label debits the Shippo account for real. Left off, a paid order is
# logged and you buy the label from the Shippo dashboard. Set to "true" only
# once you trust the flow end to end.
SHIPPO_AUTO_BUY_LABEL=false

# --- Where parcels ship from ----------------------------------------------
# Shippo can't quote a rate without a real origin address.
SHIP_FROM_NAME=MiMi Crack
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

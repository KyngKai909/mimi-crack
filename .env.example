# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
# ---------------------------------------------------------------------------

# Public origin of the site. Used for OG tags and Stripe redirect URLs.
#
# Leave it UNSET rather than blank on Vercel — preview deployments fall back to
# VERCEL_URL automatically and get their own absolute URLs. Set it only for the
# production environment, once there's a real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3310

# --- Launch gate -----------------------------------------------------------
# Everything is rewritten to the /soon teaser until this moment passes, then
# the gate lifts on its own. Note the offset: California is on PDT (UTC-7) in
# September, so this is 5pm Pacific on the 22nd (00:00 UTC on the 23rd).
NEXT_PUBLIC_LAUNCH_AT=2026-09-22T17:00:00-07:00

# Visit any page with ?preview=<this> to see the real shop before launch; it
# sets a cookie for 30 days. Leave it blank and ?preview=1 works instead —
# set a value to close that off.
LAUNCH_PREVIEW_TOKEN=

# --- Formspree (launch list) ------------------------------------------------
# The form id from your Formspree dashboard, e.g. xdorwkyz. Without it the
# email field renders but explains that it isn't connected yet.
NEXT_PUBLIC_FORMSPREE_ID=

# --- Stripe ----------------------------------------------------------------
# Dashboard -> Developers -> API keys. Use sk_test_... until you're live.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, or from
# the webhook endpoint you create in the Stripe dashboard for production.
STRIPE_WEBHOOK_SECRET=

# --- Shippo ----------------------------------------------------------------
# goshippo.com -> Settings -> API. shippo_test_... works without spending money.
SHIPPO_API_KEY=

# Buying a label debits the Shippo account for real. Left off, a paid order is
# logged and you buy the label from the Shippo dashboard. Set to "true" only
# once you trust the flow end to end.
SHIPPO_AUTO_BUY_LABEL=false

# --- Where parcels ship from ----------------------------------------------
# Shippo can't quote a rate without a real origin address.
SHIP_FROM_NAME=MiMi Crack
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
